{
  "name": "@smeditor/extension-image",
  "version": "0.0.4",
  "description": "Image node for SMEditor — insert by URL or upload, with alt text and alignment.",
  "license": "MIT",
  "author": "SMEditor contributors",
  "homepage": "https://github.com/sCruze/smeditor/tree/main/packages/extension-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sCruze/smeditor.git",
    "directory": "packages/extension-image"
  },
  "bugs": {
    "url": "https://github.com/sCruze/smeditor/issues"
  },
  "keywords": [
    "smeditor",
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "extension",
    "image"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@smeditor/core": ">=0.0.1 <0.1.0"
  },
  "devDependencies": {
    "@smeditor/core": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
