{
  "name": "@smeditor/starter-kit",
  "version": "0.0.4",
  "description": "Curated set of base extensions for SMEditor — the MVP toolset including paragraph, headings, marks, lists, blockquote, code block, horizontal rule, image, table, alignment, markdown shortcuts, placeholder and history.",
  "license": "MIT",
  "author": "SMEditor contributors",
  "homepage": "https://github.com/sCruze/smeditor/tree/main/packages/starter-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sCruze/smeditor.git",
    "directory": "packages/starter-kit"
  },
  "bugs": {
    "url": "https://github.com/sCruze/smeditor/issues"
  },
  "keywords": [
    "smeditor",
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "preset",
    "bundle"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smeditor/extension-blockquote": "workspace:*",
    "@smeditor/extension-bold": "workspace:*",
    "@smeditor/extension-bullet-list": "workspace:*",
    "@smeditor/extension-clear-formatting": "workspace:*",
    "@smeditor/extension-code-block": "workspace:*",
    "@smeditor/extension-hard-break": "workspace:*",
    "@smeditor/extension-heading": "workspace:*",
    "@smeditor/extension-history": "workspace:*",
    "@smeditor/extension-horizontal-rule": "workspace:*",
    "@smeditor/extension-image": "workspace:*",
    "@smeditor/extension-italic": "workspace:*",
    "@smeditor/extension-link": "workspace:*",
    "@smeditor/extension-list-item": "workspace:*",
    "@smeditor/extension-markdown": "workspace:*",
    "@smeditor/extension-ordered-list": "workspace:*",
    "@smeditor/extension-paragraph": "workspace:*",
    "@smeditor/extension-placeholder": "workspace:*",
    "@smeditor/extension-strike": "workspace:*",
    "@smeditor/extension-table": "workspace:*",
    "@smeditor/extension-task-item": "workspace:*",
    "@smeditor/extension-task-list": "workspace:*",
    "@smeditor/extension-text-align": "workspace:*",
    "@smeditor/extension-underline": "workspace:*"
  },
  "peerDependencies": {
    "@smeditor/core": ">=0.0.1 <0.1.0"
  },
  "devDependencies": {
    "@smeditor/core": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
