{
  "name": "@smeditor/export-pdf",
  "version": "0.0.1",
  "description": "Export a SMEditor document to a PDF file (basic text flow).",
  "license": "MIT",
  "author": "SMEditor contributors",
  "homepage": "https://github.com/sCruze/smeditor/tree/main/packages/export-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sCruze/smeditor.git",
    "directory": "packages/export-pdf"
  },
  "bugs": {
    "url": "https://github.com/sCruze/smeditor/issues"
  },
  "keywords": [
    "smeditor",
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "export",
    "pdf"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@smeditor/core": ">=0.0.1 <0.1.0"
  },
  "devDependencies": {
    "@smeditor/core": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
