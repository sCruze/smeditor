{
  "name": "@smeditor/react",
  "version": "0.0.1",
  "description": "React bindings for SMEditor.",
  "license": "MIT",
  "author": "SMEditor contributors",
  "homepage": "https://github.com/sCruze/smeditor/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sCruze/smeditor.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/sCruze/smeditor/issues"
  },
  "keywords": [
    "smeditor",
    "rich-text",
    "editor",
    "wysiwyg",
    "contenteditable",
    "react",
    "react-component"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react --external react-dom",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@smeditor/core": ">=0.0.1 <0.1.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@smeditor/core": "workspace:*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "jsdom": "^29.1.1",
    "vitest": "^1.6.0"
  }
}
