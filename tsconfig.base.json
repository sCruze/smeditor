        "./packages/extension-task-list/src/index.ts"
      ],
      "@smeditor/extension-task-item": [
        "./packages/extension-task-item/src/index.ts"
      ],
      "@smeditor/extension-text-align": [
        "./packages/extension-text-align/src/index.ts"
