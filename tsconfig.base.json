      ],
      "@smeditor/extension-text-stroke": [
        "./packages/extension-text-stroke/src/index.ts"
      ],
      "@smeditor/extension-background-color": [
        "./packages/extension-background-color/src/index.ts"
      ],
      "@smeditor/extension-word-count": [
